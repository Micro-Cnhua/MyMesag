    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 信封主体（白色圆角矩形） -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M32,32 h44 a8,8 0 0 1 8,8 v28 a8,8 0 0 1 -8,8 h-44 a8,8 0 0 1 -8,-8 v-28 a8,8 0 0 1 8,-8 z" />

